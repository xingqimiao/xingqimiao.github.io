# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# local tooling and workspace junk (never deploy these)
/.tmp-*/
/.equal-admin-trash/
/migration-backups/
/scratch_scripts.js
/manager_server.py
/KiraEqual_Manager.vbs
/start_manager.bat
/start_manager_silent.vbs
/stop_manager.bat
/Logo.png
/visual-stories*.png
/verify-glow*.mjs
